{
  "servers": [
    {
      "name": "github",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "authorization_token": "${GITHUB_MCP_TOKEN}",
      "blocked_tools": [
        "delete_file",
        "delete_repository"
      ],
      "configs": {
        "search_repositories": { "enabled": true, "defer_loading": false },
        "get_file_contents": { "enabled": true, "defer_loading": false }
      }
    },
    {
      "name": "read-only-calendar",
      "url": "https://mcp.example.com/calendar",
      "authorization_token": "${CALENDAR_MCP_TOKEN}",
      "allowed_tools": [
        "search_events",
        "list_events"
      ]
    },
    {
      "name": "docs-search",
      "url": "https://mcp.example.com/docs",
      "enabled": false,
      "resources": true
    }
  ]
}
