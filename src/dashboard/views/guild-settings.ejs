        async function validateFeedUrl(url, guildId) {
            const resp = await fetch(`/api/guild/${guildId}/validate-feed`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url })
            });
            return resp.json();
