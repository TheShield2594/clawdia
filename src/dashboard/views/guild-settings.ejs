                <section id="analytics" class="panel">
                    <div class="panel-head">
                        <h2>Insights &amp; Recommendations</h2>
                        <p>Track retention, active hours, toxic channels, mod SLA trends, and next-best actions.</p>
                    </div>

                    <!-- Skeleton loader -->
                    <div id="analytics-skeleton">
                        <div style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1rem">
                            <div class="skel-tile"></div><div class="skel-tile"></div><div class="skel-tile"></div>
                        </div>
                        <div class="skel-bar" style="width:60%;margin-bottom:.5rem"></div>
