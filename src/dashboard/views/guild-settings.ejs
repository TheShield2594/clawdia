    <script nonce="<%= locals.cspNonce %>">
        // Only the per-request data lives inline; the 200 KB of behaviour that
        // consumes it is in the cacheable scripts below.
        window.CLAWDIA_BOOTSTRAP = {
            guildId:                <%- jsonForScript(guild.id) %>,
            guildName:              <%- jsonForScript(guild.name) %>,
            channels:               <%- jsonForScript(channels || []) %>,
            channelNames:           <%- jsonForScript(Object.fromEntries((channels || []).map(c => [c.id, c.name]))) %>,
            roles:                  <%- jsonForScript(roles || []) %>,
            roleNames:              <%- jsonForScript(Object.fromEntries((roles || []).map(r => [r.id, r.name]))) %>,
            dailyNewsProfiles:      <%- jsonForScript(settings.dailyNewsProfiles || []) %>,
            escalationLadder:       <%- jsonForScript(settings.moderation?.escalation?.ladder || []) %>,
            commandPolicyRules:     <%- jsonForScript(settings.commandPolicies?.rules || []) %>,
            commandPolicyCooldowns: <%- jsonForScript(settings.commandPolicies?.cooldownOverrides || []) %>,
            shop:                   <%- jsonForScript(settings.shop || []) %>,
            jobs:                   <%- jsonForScript(settings.jobs || []) %>,
            defaultJobs:            <%- jsonForScript(defaultJobs) %>,
            jobTiers:               <%- jsonForScript(settings.jobTiers || []) %>,
            defaultTiers:           <%- jsonForScript(defaultTiers) %>,
            builtinAchievements:    <%- jsonForScript(builtinAchievements || []) %>,
            disabledAchievements:   <%- jsonForScript(settings.achievements?.disabledAchievements || []) %>,
            customAchievements:     <%- jsonForScript(settings.achievements?.customAchievements || []) %>,
            personas:               <%- jsonForScript((settings.ai && settings.ai.channelPersonas) || []) %>,
            // Stamped with the file's content hash here, where asset() lives,
            // so the lazily injected <script> is cached as hard as every other
            // asset and still busts on a version bump.
            chartJsUrl:             <%- jsonForScript(asset('/vendor/chart.umd.min.js')) %>,
        };
    </script>
    <script defer src="<%= asset('/settings-payload.js') %>"></script>
    <%# The page's behaviour, in load order (#935). It was one 5,206-line
        guild-settings.js; it is the shared machinery, then one script per
        settings panel, then the shell. `defer` keeps them in document order
        and the order is the contract: dashboard-core.js defines what the
        panels register into, and guild-settings.js takes the unsaved-changes
        baseline at its end, which has to happen after every panel above it has
        rendered into the panel that shipped with the page. %>
    <script defer src="<%= asset('/dashboard-core.js') %>"></script>
    <script defer src="<%= asset('/chart-support.js') %>"></script>
    <script defer src="<%= asset('/panel-messages.js') %>"></script>
