                var resp = await fetch('/api/guild/' + guildId + '/knowledge-base/' + id, { method: 'DELETE' });
                if (resp.ok) {
                    toast('Entry removed ✓', 'success');
                    kbLoaded = false;
                    loadKnowledgeBase();
                } else {
                    toast('Failed to remove entry', 'error');
                }
            } catch (e) {
                console.error(e);
                toast('An error occurred', 'error');
