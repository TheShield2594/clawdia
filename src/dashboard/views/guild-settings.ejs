                            .then(r => r.ok ? null : r.json().then(e => e.error || 'Upload failed'))
                            .catch(() => 'Upload error');
                    });
                    const deletes = [..._shopItemClearedImages].map(itemId =>
                        fetch(`/api/item-image/shop/${guildId}/${itemId}`, { method: 'DELETE' })
                            .then(r => r.ok ? null : 'Delete failed')
                            .catch(() => 'Delete error')
                    );
