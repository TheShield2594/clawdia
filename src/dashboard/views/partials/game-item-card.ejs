<div class="game-item-card" id="gic-<%= item.id %>">
    <div class="game-item-img-wrap">
        <% if (item.hasImage) { %>
            <img
                class="game-item-img"
                id="gic-img-<%= item.id %>"
                src="/api/v1/item-image/activity/<%= guild.id %>/<%= item.id %>"
                alt=""
                <%# If the upload 404s, the image hides itself and the emoji
                    below takes its place. guild-settings.js listens for the
                    error in the capture phase (#887); `error` does not bubble,
                    and an on* attribute is what the CSP no longer allows. -%>
                data-emoji-fallback="gic-emoji-<%= item.id %>"
            >
            <span class="game-item-emoji" id="gic-emoji-<%= item.id %>" style="display:none"><%= item.emoji %></span>
        <% } else { %>
            <span class="game-item-emoji" id="gic-emoji-<%= item.id %>"><%= item.emoji %></span>
        <% } %>
    </div>
    <div class="game-item-info">
        <div class="game-item-name"><%= item.label %></div>
        <div class="game-item-id"><%= item.id %></div>
    </div>
</div>
