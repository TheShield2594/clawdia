<!DOCTYPE html>
<html lang="en">
<%
    // Written once and used three times below — the tab title, the meta
    // description, and the Open Graph pair an unfurler reads instead of either.
    const pageTitle = 'Clawdia — A chill Discord bot with serious teeth';
    const pageDescription = 'Moderation, leveling, economy, chat with Clawdia and analytics — in one self-hosted Discord bot. Own your data.';

    // Where every documentation, changelog and licence link in the footer
    // resolves. Written once so a fork renaming the repository moves them
    // together rather than leaving a dozen 404s behind.
    const repo = 'https://github.com/TheShield2594/clawdia';

    // The share card and the alt text that travels with it, written once for
    // the Open Graph and Twitter pairs below. Absolute and therefore
    // conditional: an unfurler fetches the URL and resolves nothing against the
    // page it came from, and `baseUrl` is null in the misconfiguration that
    // already refuses to start.
    const cardImage = locals.baseUrl ? `${locals.baseUrl}${asset('/og-image.png')}` : null;
    const cardImageAlt = 'Clawdia — a chill Discord bot with serious teeth. Moderation, leveling, economy, chat with Clawdia and analytics.';
%>
<head>
    <%- include('partials/head', { title: pageTitle, description: pageDescription }) %>

    <%#
        Open Graph and Twitter Card, on this view only (#687).

        Links to a Discord bot are shared in Discord, and Discord unfurls OG
        tags — so this is not an SEO nicety at the edge of the product, it is
        how the product looks in its own main distribution channel. Without
        them a shared link renders as bare blue text.

        Deliberately not in partials/head.ejs and deliberately not on the other
        two views: dashboard.ejs and guild-settings.ejs sit behind checkAuth,
        no crawler or unfurler can reach them, and a card for a page that
        answers a redirect to /login describes nothing.

        Everything absolute, off the validated DASHBOARD_URL: an unfurler
        fetches the URL and resolves nothing against the page it came from, so
        a root-relative og:image is simply dropped.
    -%>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Clawdia">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDescription %>">
    <%_ if (cardImage) { _%>
    <meta property="og:url" content="<%= baseUrl %>/">
    <meta property="og:image" content="<%= cardImage %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <%# The card carries text, so it needs alt text like any other image. -%>
    <meta property="og:image:alt" content="<%= cardImageAlt %>">
    <link rel="canonical" href="<%= baseUrl %>/">
    <%_ } _%>
    <%# summary_large_image rather than summary: the card is 1.91:1 artwork
        with type in it, and the square summary crop cuts the wordmark off.

        twitter:image names the same file the og:image pair above does, and is
        written out rather than left to the fallback (#947). Twitter does read
        og:image when there is no twitter:image, but that is documented
        behaviour rather than a guarantee, and every other unfurler that claims
        to speak Twitter cards — Slack, Teams, a dozen link previewers — reads
        the tags each in its own way. One extra line buys a card that does not
        depend on any of them agreeing. -%>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= pageTitle %>">
    <meta name="twitter:description" content="<%= pageDescription %>">
    <%_ if (cardImage) { _%>
    <meta name="twitter:image" content="<%= cardImage %>">
    <meta name="twitter:image:alt" content="<%= cardImageAlt %>">
    <%_ } _%>
    <%# The address-bar tint on a mobile browser, matching the cream this page
        actually paints. Here rather than in partials/head.ejs on purpose: the
        other two views are the dark dashboard chrome, and one shared value
        would be wrong for whichever half did not choose it. -%>
    <meta name="theme-color" content="#faf6ef">
</head>
<body style="background:var(--cream-50);">

<div class="cw-home">

    <!-- NAV -->
    <%- include('partials/nav', { page: 'home' }) %>

    <!-- HERO -->
    <header class="cw-hero">
        <div class="cw-hero-eyebrow">
            <span class="cw-dot"></span>
            v<%= version %> · Insights layer is live
        </div>
        <h1 class="font-display cw-hero-title">
            A <em>chill</em> Discord bot<br>
            with <span class="cw-underline-claw">serious teeth.</span>
        </h1>
        <p class="cw-hero-sub">
            Moderation, leveling, economy, chat with Clawdia and decision-grade analytics — in one self-hosted bot. Own your data. Skip the cloud lock-in. Up and purring in five minutes.
        </p>
        <div class="cw-hero-cta">
            <% if (user) { %>
                <a href="/dashboard" class="cw-btn cw-btn-claw">Open Dashboard <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            <% } else { %>
                <a href="/auth/login" class="cw-btn cw-btn-claw">Add to Discord <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            <% } %>
            <a href="<%= repo %>" target="_blank" rel="noopener" class="cw-btn cw-btn-ghost">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                View on GitHub
            </a>
        </div>
        <%# Measured off this instance, not written here (#704). This row used
            to read "14,200 servers · 2.1M commands / day · 99.98% uptime · 90d",
            which on a self-hosted deploy described someone else's install. The
            whole row is dropped when `stats` is null — the client has not been
            ready, so the honest answer is nothing rather than zero. %>
        <div class="cw-hero-stats">
            <% if (stats) { %>
                <div><b><%= stats.servers %></b><span>servers</span></div>
                <i></i>
                <div><b><%= stats.members %></b><span>members reached</span></div>
                <i></i>
                <div><b><%= stats.uptime %></b><span>uptime · this instance</span></div>
                <i></i>
            <% } %>
            <div><b>MIT</b><span>open source</span></div>
        </div>

        <%# Clawdia herself — a chill cat mid-swipe, the tagline made literal.
            Decorative: the hero's meaning is carried by the heading and copy, so
            the mark is hidden from assistive tech rather than announced. The
            intrinsic width/height keep the box reserved before the PNG lands,
            and fetchpriority marks it as the one above-the-fold image worth
            racing the stylesheet for. -%>
        <img class="cw-hero-art" src="<%= asset('/clawdia-hero.png') %>"
             width="604" height="900" alt="" aria-hidden="true"
             decoding="async" fetchpriority="high">
    </header>

    <!-- MODULE STRIP -->
    <div class="cw-strip" id="modules">
        <div class="cw-strip-inner">
            <span class="cw-strip-label">11 modules</span>
            <div class="cw-strip-items">
                <span>· Moderation</span>
                <span>· Welcome</span>
                <span>· Leveling</span>
                <span>· Economy</span>
                <span>· RSS Feeds</span>
                <span>· Daily News</span>
                <span>· Ask Clawdia</span>
                <span>· Reminders</span>
                <span>· Auto-roles</span>
                <span>· Custom commands</span>
                <span>· Insights</span>
            </div>
        </div>
    </div>

    <!-- FEATURES -->
    <section id="features" class="cw-section">
        <div class="cw-section-header">
            <div>
                <div class="cw-eyebrow">// Everything bundled</div>
                <h2 class="cw-section-title">One bot. Every module<br>you'd otherwise stitch together.</h2>
            </div>
            <p class="cw-section-blurb">Clawdia replaces Carl-bot, MEE6, Dyno, Groovy and a half-dozen analytics scripts. Toggle modules per server.</p>
        </div>
        <div class="cw-feature-grid">
            <!-- Moderation -->
            <div class="cw-feature">
                <div class="cw-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 2.6v5.4c0 4.5-3 7.5-7 8.5-4-1-7-4-7-8.5V5.6L12 3z"/><path d="M9.1 13.7l2.4-2.9M10.8 14.7l2.4-2.9M12.5 15.6l2.4-2.9"/></svg>
                </div>
                <h3>Moderation</h3>
                <p>Ban, kick, warn, mute, timeout. Auto-flag spam, invites, links. Every action logged with reason and timestamp.</p>
                <span class="cw-feature-tag">core</span>
            </div>
            <!-- Ask Clawdia — dark -->
            <div class="cw-feature dark">
                <div class="cw-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7.4 7.3L6.1 4l3.3 1.8M16.6 7.3L17.9 4l-3.3 1.8"/><path d="M5 7.2h14a1.2 1.2 0 0 1 1.2 1.2v6.3a1.2 1.2 0 0 1-1.2 1.2h-6.3L9 20v-3.1H5a1.2 1.2 0 0 1-1.2-1.2V8.4A1.2 1.2 0 0 1 5 7.2z"/><circle cx="9.7" cy="11.6" r=".95" fill="currentColor" stroke="none"/><circle cx="14.3" cy="11.6" r=".95" fill="currentColor" stroke="none"/></svg>
                </div>
                <h3>Ask Clawdia</h3>
                <p>Bring your own model — OpenAI, Gemini or self-hosted Ollama. Per-server prompts and dedicated channels.</p>
                <span class="cw-feature-tag">smart</span>
            </div>
            <!-- Welcome -->
            <div class="cw-feature">
                <div class="cw-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16c2 0 2-3 4-3s2 3 4 3 2-3 4-3 2 3 4 3"/><path d="M3 11c2 0 2-3 4-3s2 3 4 3 2-3 4-3 2 3 4 3"/></svg>
                </div>
                <h3>Welcome</h3>
                <p>Custom welcome cards with avatar, server name and member count. Variables for personalization.</p>
                <span class="cw-feature-tag">core</span>
            </div>
            <!-- Leveling -->
            <div class="cw-feature">
                <div class="cw-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="13" width="3.4" height="7" rx="1.2"/><rect x="10.3" y="9" width="3.4" height="11" rx="1.2"/><rect x="16.6" y="5" width="3.4" height="15" rx="1.2"/></svg>
                </div>
                <h3>Leveling</h3>
                <p>XP per message, configurable rate. Leaderboards, rank cards, and level-up announcements.</p>
                <span class="cw-feature-tag">fun</span>
            </div>
            <!-- Economy -->
            <div class="cw-feature">
                <div class="cw-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><ellipse cx="12" cy="13.3" rx="2.2" ry="1.7" fill="currentColor" stroke="none"/><circle cx="9.3" cy="10.7" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="9.6" r="1" fill="currentColor" stroke="none"/><circle cx="14.7" cy="10.7" r="1" fill="currentColor" stroke="none"/></svg>
                </div>
                <h3>Economy</h3>
                <p>Currency, daily rewards, work, transfers, jobs, blackjack, roulette and crash.</p>
                <span class="cw-feature-tag">fun</span>
            </div>
            <!-- RSS -->
            <div class="cw-feature">
                <div class="cw-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4a16 16 0 0 1 16 16"/><path d="M4 11a9 9 0 0 1 9 9"/><circle cx="5" cy="19" r="1.4" fill="currentColor"/></svg>
                </div>
                <h3>RSS &amp; Digest</h3>
                <p>Watch feeds individually or compile multiple sources into one daily post at a scheduled hour.</p>
                <span class="cw-feature-tag">core</span>
            </div>
            <!-- Insights — dark -->
            <div class="cw-feature dark">
                <div class="cw-feature-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg>
                </div>
                <h3>Insights</h3>
                <p>Retention cohorts, active hours heatmap, toxic channel detection, mod SLA, newcomer conversion.</p>
                <span class="cw-feature-tag new">new</span>
            </div>
        </div>
    </section>

    <!-- INSIGHTS SHOWPIECE -->
    <section id="insights" class="cw-show">
        <div class="cw-show-inner">
            <div>
                <div class="cw-eyebrow">// Insights</div>
                <h2>Decisions, not<br>event logs <em>·</em></h2>
                <p>Most Discord analytics dump raw events at you. Clawdia surfaces the five questions server owners actually ask — and answers them.</p>
                <ul>
                    <li><em>→</em> What hours should our events run?</li>
                    <li><em>→</em> Which channels need more mod coverage?</li>
                    <li><em>→</em> Which week's joiners stuck around?</li>
                    <li><em>→</em> How fast is our team responding to flags?</li>
                    <li><em>→</em> Are newcomers converting to contributors?</li>
                </ul>
            </div>
            <div class="cw-show-card">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
                    <div>
                        <div style="font-family:'Instrument Serif',serif; font-size:22px; color:var(--cream-50);">Active hours</div>
                        <div style="font-size:12px; color:var(--ink-400); font-family:'JetBrains Mono',monospace; margin-top:2px;">UTC · last 28 days</div>
                    </div>
                    <div style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:var(--ink-850);font-size:12px;color:var(--ink-200);border:1px solid var(--ink-800);font-family:'JetBrains Mono',monospace;">peak · Sat 21:00</div>
                </div>
                <!-- Illustrative demo data, drawn as 168 coloured cells with no text of
                     their own. Hidden from assistive tech rather than announced as 168
                     empty divs: there is nothing in them to read. -->
                <div class="cw-heatmap" id="insights-heatmap" aria-hidden="true"></div>
                <div class="cw-show-stats">
                    <div class="cw-show-stat">
                        <div class="v">D7 · 62%</div>
                        <div class="l">retention</div>
                        <div class="delta">▲ 4.2 pts</div>
                    </div>
                    <div class="cw-show-stat">
                        <div class="v">12m</div>
                        <div class="l">mod SLA</div>
                        <div class="delta">▲ 38% faster</div>
                    </div>
                    <div class="cw-show-stat">
                        <div class="v">#general</div>
                        <div class="l">hottest channel</div>
                        <div class="delta bad">▼ 23% toxic</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- COMPARE -->
    <section class="cw-section" style="padding-top:90px; padding-bottom:80px;">
        <div class="cw-section-header">
            <div>
                <div class="cw-eyebrow">// vs. the alternatives</div>
                <h2 class="cw-section-title">Things other bots<br>charge $9/mo for.</h2>
            </div>
        </div>
        <%# A real table, because the comparison is the page's main argument and a
            grid of bare divs reads as a flat run of disconnected words: nothing
            ties "● included" to either its feature row or its bot column (#912).

            The explicit `role` on every part is not belt and braces. The layout
            is still CSS grid — `display: grid` on the table, `display: contents`
            on its rows — and a browser that is not laying an element out as a
            table stops reporting it as one. The elements are what a reader of the
            markup sees; the roles are what keep that true after the CSS. %>
        <table class="cw-compare" role="table">
            <caption class="sr-only">Clawdia compared with MEE6 Pro and Carl-bot Premium, feature by feature.</caption>
            <thead role="rowgroup">
                <tr role="row">
                    <th scope="col" role="columnheader">Feature</th>
                    <th scope="col" role="columnheader" class="hi">Clawdia</th>
                    <th scope="col" role="columnheader">MEE6 Pro</th>
                    <th scope="col" role="columnheader">Carl-bot Premium</th>
                </tr>
            </thead>
            <tbody role="rowgroup">
                <tr role="row">
                    <th scope="row" role="rowheader">Self-hosted, your data</th>
                    <td role="cell" class="hi"><span class="cw-compare-yes">● included</span></td>
                    <td role="cell"><span class="cw-compare-no">— not available</span></td>
                    <td role="cell"><span class="cw-compare-no">— not available</span></td>
                </tr>
                <tr role="row">
                    <th scope="row" role="rowheader">Ask Clawdia (OpenAI / Gemini / Ollama)</th>
                    <td role="cell" class="hi"><span class="cw-compare-yes">● included</span></td>
                    <td role="cell"><span class="cw-compare-warn">◐ limited</span></td>
                    <td role="cell"><span class="cw-compare-no">— not available</span></td>
                </tr>
                <tr role="row">
                    <th scope="row" role="rowheader">Insights &amp; retention cohorts</th>
                    <td role="cell" class="hi"><span class="cw-compare-yes">● included</span></td>
                    <td role="cell"><span class="cw-compare-no">— not available</span></td>
                    <td role="cell"><span class="cw-compare-no">— not available</span></td>
                </tr>
                <tr role="row">
                    <th scope="row" role="rowheader">Daily news digest from multi-feed</th>
                    <td role="cell" class="hi"><span class="cw-compare-yes">● included</span></td>
                    <td role="cell"><span class="cw-compare-no">— not available</span></td>
                    <td role="cell"><span class="cw-compare-no">— not available</span></td>
                </tr>
                <tr role="row">
                    <th scope="row" role="rowheader">Custom welcome cards</th>
                    <td role="cell" class="hi"><span class="cw-compare-yes">● included</span></td>
                    <td role="cell"><span class="cw-compare-yes">● included</span></td>
                    <td role="cell"><span class="cw-compare-yes">● included</span></td>
                </tr>
                <tr role="row">
                    <th scope="row" role="rowheader">Source code &middot; MIT</th>
                    <td role="cell" class="hi"><span class="cw-compare-yes">● included</span></td>
                    <td role="cell"><span class="cw-compare-no">— not available</span></td>
                    <td role="cell"><span class="cw-compare-no">— not available</span></td>
                </tr>
                <tr role="row">
                    <th scope="row" role="rowheader">Monthly cost</th>
                    <td role="cell" class="hi"><b>free</b></td>
                    <td role="cell"><b>$11.95</b></td>
                    <td role="cell"><b>$5</b></td>
                </tr>
            </tbody>
        </table>
    </section>

    <!-- SELF-HOST -->
    <section id="self-host" class="cw-host">
        <div class="cw-host-inner">
            <div>
                <div class="cw-eyebrow">// Self-host</div>
                <h2>Up and purring in <em>five minutes.</em></h2>
                <p>One Docker compose file. Bring your own MongoDB. Optionally point at Ollama for completely offline AI. No vendor account required.</p>
                <div class="cw-host-features">
                    <div class="cw-host-feature">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97742" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        <div><b>Docker / Portainer</b>One-click stack import</div>
                    </div>
                    <div class="cw-host-feature">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97742" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        <div><b>Node 18+</b>Or run bare-metal</div>
                    </div>
                    <div class="cw-host-feature">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97742" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        <div><b>MongoDB</b>Self-hosted or Atlas</div>
                    </div>
                    <div class="cw-host-feature">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97742" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                        <div><b>Ollama-ready</b>Local AI, zero API cost</div>
                    </div>
                </div>
                <div class="cw-host-cta">
                    <a href="<%= repo %>/blob/main/docs/SETUP_GUIDE.md" target="_blank" rel="noopener" class="cw-btn cw-btn-dark">Read setup guide <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                    <a href="<%= repo %>" target="_blank" rel="noopener" class="cw-btn cw-btn-ghost">⌥ View on GitHub</a>
                </div>
            </div>
            <div class="cw-terminal">
                <div class="cw-terminal-bar">
                    <span class="cw-terminal-dot" style="background:#ff5f57;"></span>
                    <span class="cw-terminal-dot" style="background:#febc2e;"></span>
                    <span class="cw-terminal-dot" style="background:#28c840;"></span>
                    <span>~/clawdia · zsh</span>
                </div>
                <pre><span class="pr">$</span> git clone git@github.com:TheShield2594/clawdia.git
<span class="pr">$</span> cd clawdia &amp;&amp; cp .env.example .env
<span class="cm"># add DISCORD_TOKEN, MONGODB_URI, etc.</span>
<span class="pr">$</span> docker compose up -d

<span class="ok">✓</span> mongo               <span class="cm">started in 1.2s</span>
<span class="ok">✓</span> clawdia-bot         <span class="cm">connected as Clawdia#7841</span>
<span class="ok">✓</span> clawdia-dashboard   <span class="cm">listening on :3000</span>

<span class="key">→</span> Dashboard ready at <span class="pr">http://localhost:3000</span>
<span class="key">→</span> Invite Clawdia: <span class="pr">discord.gg/oauth/...</span></pre>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cw-cta">
        <%# A faint paw pressed into the corner of the closing band — decorative,
            so hidden from assistive tech; the copy carries the message. -%>
        <img class="cw-cta-paw" src="<%= asset('/clawdia-paw.png') %>" alt="" aria-hidden="true" decoding="async" loading="lazy">
        <h2 class="font-display">Stop running <em>five bots.</em><br>Start running <em>one.</em></h2>
        <p>Free forever. Open source. Add Clawdia to your server in under a minute, or clone the repo and self-host.</p>
